function evaluateSkipCi(commitMessage, actor, skipBots) {
	if (/\[(skip\s+ci|ci\s+skip)\]/i.test(commitMessage)) {
		return {
			skip: true,
			reason: "commit-marker"
		};
	};
	if (skipBots && actor.endsWith("[bot]")) {
		return {
			skip: true,
			reason: "bot-actor"
		};
	};
	return {
		skip: false,
		reason: "normal"
	};
}

