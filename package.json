{
  "name": "@rodkisten/github-actions",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsdown && npm run actions:generate",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "release": "semantic-release",
    "prebuild": "node scripts/check-source-layout.mjs",
    "docs:actions": "node scripts/generate-action-docs.mjs",
    "actions:generate": "node scripts/generate-public-actions.mjs",
    "actions:check": "node scripts/generate-public-actions.mjs --check"
  },
  "dependencies": {
    "@actions/core": "^2.0.0",
    "@actions/github": "^7.0.0",
    "@actions/tool-cache": "^2.0.1",
    "@octokit/auth-app": "^7.0.0",
    "@octokit/request": "^9.0.0",
    "handlebars": "^4.7.8",
    "picomatch": "^4.0.3",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/picomatch": "^4.0.2",
    "tsdown": "^0.23.7",
    "typescript": "^6.0.0",
    "vitest": "^3.2.0",
    "semantic-release": "^25.0.0",
    "@semantic-release/commit-analyzer": "^13.0.0",
    "@semantic-release/release-notes-generator": "^14.0.0",
    "@semantic-release/npm": "^13.0.0",
    "@semantic-release/github": "^12.0.0",
    "@semantic-release/git": "^10.0.1"
  },
  "engines": {
    "node": ">=24"
  },
  "version": "1.23.2"
}
