{
  "name": "@rodkisten/github-actions",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsdown && npm run actions:generate",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "release": "semantic-release",
    "prebuild": "node scripts/check-source-layout.mjs",
    "docs:actions": "node scripts/generate-action-docs.mjs",
    "actions:generate": "node scripts/generate-public-actions.mjs",
    "actions:check": "node scripts/generate-public-actions.mjs --check"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "@actions/tool-cache": "^4.0.0",
    "@octokit/auth-app": "^8.3.1",
    "@octokit/request": "^10.0.16",
    "handlebars": "^4.7.10",
    "picomatch": "^4.0.7",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.10",
    "@types/picomatch": "^4.0.3",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2",
    "vitest": "^5.1.2",
    "semantic-release": "^26.0.1",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@semantic-release/npm": "^13.2.0",
    "@semantic-release/github": "^12.0.11",
    "@semantic-release/git": "^11.0.1"
  },
  "engines": {
    "node": ">=24"
  },
  "version": "1.25.0"
}
